  { "name": "marker-grabbed", "url": "http://localhost:5173/?shot=proyectos&marker=grabbed&ink=demo", "width": 1280, "height": 800, "settle": 1400, "steps": [{ "eval": "window.MTC.ready.then(() => 'ready')", "wait": 300 }], "out": "tools/out/shots/marker-grabbed.png" },
  { "name": "marker-draw-sim", "url": "http://localhost:5173/?shot=proyectos", "width": 1280, "height": 800, "settle": 1400, "steps": [{ "eval": "window.MTC.ready.then(() => { const m = document.getElementById('marker'); m.scrollIntoView({ behavior: 'instant', block: 'center' }); const r = m.getBoundingClientRect(); const x0 = r.left + 12, y0 = r.top + r.height / 2; const ev = (type, x, y) => m.dispatchEvent(new PointerEvent(type, { bubbles: true, pointerId: 1, isPrimary: true, clientX: x, clientY: y, button: 0, pointerType: 'mouse' })); ev('pointerdown', x0, y0); for (let i = 1; i <= 40; i++) ev('pointermove', x0 - i * 6, y0 - Math.sin(i / 5) * 40); ev('pointerup', x0 - 240, y0 - 20); return 'drawn'; })", "wait": 500 }, { "eval": "JSON.stringify({ paths: document.querySelectorAll('#ink path').length, strokes: MTC.marker.strokes.length, state: MTC.marker.state })", "print": true }], "out": "tools/out/shots/marker-draw-sim.png" },
  { "name": "marker-evict", "url": "http://localhost:5173/?shot=proyectos&ink=demo&inkn=45", "width": 1280, "height": 800, "settle": 1600, "steps": [{ "eval": "window.MTC.ready.then(() => JSON.stringify({ strokes: MTC.marker.strokes.length }))", "print": true }], "out": "tools/out/shots/marker-evict.png" },
  { "name": "marker-lang-en", "url": "http://localhost:5173/?shot=proyectos&ink=demo", "width": 1280, "height": 800, "settle": 1400, "steps": [{ "eval": "window.MTC.ready.then(() => 'ready')" }, { "click": ".lang__btn[data-lang=\"en\"]", "wait": 500 }, { "eval": "document.documentElement.lang + ' ' + document.querySelectorAll('#ink path').length", "print": true }], "out": "tools/out/shots/marker-lang-en.png" },
  { "name": "marker-mobile-default", "url": "http://localhost:5173/?shot=proyectos", "width": 390, "height": 844, "mobile": true, "settle": 1400, "steps": [{ "eval": "window.MTC.ready.then(() => { const m = document.getElementById('marker'); m.scrollIntoView({ behavior: 'instant', block: 'center' }); const r = m.getBoundingClientRect(); return JSON.stringify({ left: Math.round(r.left), right: Math.round(r.right), w: Math.round(r.width) }); })", "print": true, "wait": 300 }], "out": "tools/out/shots/marker-mobile-default.png" },
